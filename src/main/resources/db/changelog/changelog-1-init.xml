<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1-create-members" author="sena">
        <createTable tableName="members"><column name="id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column><column name="first_name" type="VARCHAR(100)"><constraints nullable="false"/></column><column name="last_name" type="VARCHAR(100)"><constraints nullable="false"/></column><column name="document_number" type="VARCHAR(12)"><constraints nullable="false" unique="true"/></column><column name="phone" type="VARCHAR(12)"><constraints nullable="false"/></column><column name="email" type="VARCHAR(150)"><constraints nullable="false" unique="true"/></column><column name="membership_type" type="VARCHAR(60)"><constraints nullable="false"/></column><column name="created_at" type="TIMESTAMP"/><column name="updated_at" type="TIMESTAMP"/></createTable>
    </changeSet>
    <changeSet id="2-create-trainers" author="sena">
        <createTable tableName="trainers"><column name="id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column><column name="first_name" type="VARCHAR(100)"><constraints nullable="false"/></column><column name="last_name" type="VARCHAR(100)"><constraints nullable="false"/></column><column name="specialty" type="VARCHAR(100)"><constraints nullable="false"/></column><column name="phone" type="VARCHAR(12)"><constraints nullable="false"/></column><column name="email" type="VARCHAR(150)"><constraints nullable="false" unique="true"/></column><column name="created_at" type="TIMESTAMP"/><column name="updated_at" type="TIMESTAMP"/></createTable>
    </changeSet>
    <changeSet id="3-create-training-sessions" author="sena">
        <createTable tableName="training_sessions"><column name="id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column><column name="session_date" type="TIMESTAMP"><constraints nullable="false"/></column><column name="training_type" type="VARCHAR(100)"><constraints nullable="false"/></column><column name="duration_minutes" type="INT"><constraints nullable="false"/></column><column name="notes" type="VARCHAR(255)"/><column name="member_id" type="BIGINT"><constraints nullable="false"/></column><column name="trainer_id" type="BIGINT"><constraints nullable="false"/></column><column name="created_at" type="TIMESTAMP"/><column name="updated_at" type="TIMESTAMP"/></createTable>
    </changeSet>
    <changeSet id="4-fk-training-sessions-member" author="sena"><addForeignKeyConstraint baseTableName="training_sessions" baseColumnNames="member_id" referencedTableName="members" referencedColumnNames="id" constraintName="fk_training_sessions_member"/></changeSet>
    <changeSet id="5-fk-training-sessions-trainer" author="sena"><addForeignKeyConstraint baseTableName="training_sessions" baseColumnNames="trainer_id" referencedTableName="trainers" referencedColumnNames="id" constraintName="fk_training_sessions_trainer"/></changeSet>
</databaseChangeLog>
